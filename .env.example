# ─── Database (PostgreSQL - Neon) ───────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ─── Admin Authentication ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ─── Crypto Wallets ──────────────────────────────────────────────────────────
# Replace with your actual wallet addresses
NEXT_PUBLIC_WALLET_BTC=bc1q...your_bitcoin_address
NEXT_PUBLIC_WALLET_ETH=0x...your_ethereum_address
NEXT_PUBLIC_WALLET_USDT=T...your_usdt_trc20_address

# ─── JWT Secret ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# ─── Crypto Gateway (NOWPayments) ────────────────────────────────────────────
# API Key: Dashboard → Payment Settings → API Key
CRYPTO_GATEWAY_API_KEY=your-nowpayments-api-key
# IPN Secret: Dashboard → Payment Settings → IPN Secret Key (save on creation!)
CRYPTO_WEBHOOK_SECRET=your-ipn-secret-key

# ─── Email Service (Resend) ──────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
EMAIL_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# ─── Discord Webhook (Optional - Stock Alerts) ───────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-token

# ─── Telegram Support (Optional) ─────────────────────────────────────────────
TELEGRAM_SUPPORT_USERNAME=@your_telegram_username
# Bot token from @BotFather (for sale notifications & waitlist broadcasts)
TELEGRAM_BOT_TOKEN=
# Channel ID for waitlist broadcasts
TELEGRAM_CHANNEL_ID=
# Chat ID where sale notifications are sent (DM or group). Falls back to TELEGRAM_CHANNEL_ID if not set.
TELEGRAM_SALES_CHAT_ID=

# ─── Telegram Ops Bot (sale + stock notifications) ───────────────────────────
# Separate bot from the public channel one. Sends full sale details plus the
# remaining stock after each sale. Both values required, else it stays silent.
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# ─── Download Links ──────────────────────────────────────────────────────────
DOWNLOAD_LINK_VALIDITY_HOURS=24
DOWNLOAD_LINK_MAX_USES=3

# ─── Telegram Customer Bot (self service) ────────────────────────────────────
# Third bot, separate from the channel and ops ones. Answers /order and /resend.
TELEGRAM_CUSTOMER_BOT_TOKEN=
# Shared secret Telegram echoes back on every webhook call. Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
# Project token (public, safe in the browser). Leave empty to disable tracking.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Stock Reservations ──────────────────────────────────────────────────────
# How long a pending order holds its accounts before they return to stock
RESERVATION_TIMEOUT_MINUTES=30
# Bearer token guarding /api/cron/release-reservations (Vercel sets this header
# automatically for declared crons). Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret

# ─── Stock Alerts ────────────────────────────────────────────────────────────
LOW_STOCK_ALERT_THRESHOLD_350=5
LOW_STOCK_ALERT_THRESHOLD_500=5

# ─── Sentry (Error Monitoring) ───────────────────────────────────────────────
# Get from: https://sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# ─── App Settings ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
